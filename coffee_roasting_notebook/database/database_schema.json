{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CoffeeRoastingLogDatabase",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "beanName": { "type": "string" },
          "origin": { "type": "string" },
          "machine": { "type": "string" },
          "roastDate": { "type": "string", "format": "date" },
          "chargeMassG": { "type": "number" },
          "dropMassG": { "type": "number" },
          "chargeTemp": { "type": "number" },
          "tpTemp": { "type": "number" },
          "tpTime": { "type": "string" },
          "dryEndTemp": { "type": "number" },
          "dryEndTime": { "type": "string" },
          "fcTemp": { "type": "number" },
          "fcTime": { "type": "string" },
          "dropTemp": { "type": "number" },
          "dropTime": { "type": "string" },
          "dtrRatio": { "type": "string" },
          "lossRatio": { "type": "string" },
          "rorDatapoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timeS": { "type": "number" },
                "beanTemp": { "type": "number" },
                "ror": { "type": "number" }
              },
              "required": ["timeS", "beanTemp", "ror"]
            }
          },
          "timelineActions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "time": { "type": "string" },
                "temp": { "type": "number" },
                "burner": { "type": "string" },
                "damper": { "type": "string" },
                "note": { "type": "string" }
              },
              "required": ["time", "temp"]
            }
          },
          "cuppingNotes": {
            "type": "object",
            "properties": {
              "fragrance": { "type": "string" },
              "aroma": { "type": "string" },
              "flavor": { "type": "string" },
              "aftertaste": { "type": "string" },
              "score": { "type": "number" }
            }
          }
        },
        "required": ["id", "beanName", "origin", "machine", "roastDate", "chargeTemp", "dropTemp"]
      }
    }
  }
}
